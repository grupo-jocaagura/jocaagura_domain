{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/model_group_config.schema.json",
  "title": "ModelGroupConfig",
  "description": "Canonical JSON contract for ModelGroupConfig in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "groupId": { "type": "string" },
    "googleGroupId": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "resourceName": { "type": "string" },
    "apiSource": { "type": "string", "enum": ["directory", "cloudIdentity", "mixed"] },
    "etagSettings": { "type": "string" },
    "lastSyncStatus": { "type": "string", "enum": ["never", "ok", "error"] },
    "lastSyncAt": { "type": "string", "format": "date-time" },
    "crud": { "$ref": "./model_crud_metadata.schema.json" }
  },
  "required": ["id", "groupId", "googleGroupId", "email", "resourceName", "apiSource", "etagSettings", "lastSyncStatus", "crud"],
  "examples": [
    {
      "id": "cfg-1",
      "groupId": "group-001",
      "googleGroupId": "AAA-BBB-CCC",
      "email": "soporte@domain.com",
      "resourceName": "groups/AAA-BBB-CCC",
      "apiSource": "directory",
      "etagSettings": "etag-123",
      "lastSyncStatus": "never",
      "lastSyncAt": "2025-01-01T10:00:00.000Z",
      "crud": {
        "recordId": "cfg-1",
        "createdBy": "system@domain.com",
        "createdAt": "2025-01-01T10:00:00.000Z",
        "updatedBy": "system@domain.com",
        "updatedAt": "2025-01-01T10:00:00.000Z",
        "version": 1
      }
    }
  ]
}
