{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/medical_treatment_model.schema.json",
  "title": "MedicalTreatmentModel",
  "description": "Canonical JSON contract for MedicalTreatmentModel in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the medical treatment."
    },
    "concept": {
      "type": "string",
      "description": "Concept or description of the treatment."
    },
    "dateTimeOfRecord": {
      "type": "string",
      "format": "date-time",
      "description": "Treatment timestamp as ISO-8601 string."
    },
    "quantity": {
      "type": "integer",
      "description": "Quantity administered.",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "concept",
    "dateTimeOfRecord",
    "quantity"
  ],
  "examples": [
    {
      "id": "default_id",
      "concept": "Tratamiento de ejemplo",
      "dateTimeOfRecord": "2024-07-28T00:00:00.000Z",
      "quantity": 1
    }
  ]
}
