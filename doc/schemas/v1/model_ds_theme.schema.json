{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/model_ds_theme.schema.json",
  "title": "ModelDsTheme",
  "description": "Canonical JSON contract for a portable design system theme consumable by Flutter/Material adapters in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "colorScheme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": { "type": "string", "enum": ["light", "dark"] },
        "primary": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "onPrimary": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "secondary": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "onSecondary": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "error": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "onError": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "surface": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "onSurface": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "required": ["brightness", "primary", "onPrimary", "secondary", "onSecondary", "error", "onError", "surface", "onSurface"]
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number", "minimum": 0 },
        "fontWeight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "letterSpacing": { "type": "number" },
        "height": { "type": "number", "minimum": 0 },
        "color": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "required": ["fontFamily", "fontSize", "fontWeight", "letterSpacing", "height", "color"]
    },
    "textTheme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headlineSmall": { "$ref": "#/$defs/textStyle" },
        "titleMedium": { "$ref": "#/$defs/textStyle" },
        "bodyMedium": { "$ref": "#/$defs/textStyle" },
        "labelLarge": { "$ref": "#/$defs/textStyle" }
      },
      "required": ["headlineSmall", "titleMedium", "bodyMedium", "labelLarge"]
    }
  },
  "properties": {
    "useMaterial3": {
      "type": "boolean",
      "description": "Whether the consumer should prefer Material 3 semantics when adapting the contract."
    },
    "lightScheme": { "$ref": "#/$defs/colorScheme" },
    "darkScheme": { "$ref": "#/$defs/colorScheme" },
    "lightTextTheme": { "$ref": "#/$defs/textTheme" },
    "darkTextTheme": { "$ref": "#/$defs/textTheme" }
  },
  "required": ["useMaterial3", "lightScheme", "darkScheme", "lightTextTheme", "darkTextTheme"],
  "examples": [
    {
      "useMaterial3": true,
      "lightScheme": {
        "brightness": "light",
        "primary": 4283215696,
        "onPrimary": 4294967295,
        "secondary": 4287379350,
        "onSecondary": 4294967295,
        "error": 4290386458,
        "onError": 4294967295,
        "surface": 4294966271,
        "onSurface": 4279966491
      },
      "darkScheme": {
        "brightness": "dark",
        "primary": 4290824191,
        "onPrimary": 4278196864,
        "secondary": 4293517311,
        "onSecondary": 4278196992,
        "error": 4294948011,
        "onError": 4281794561,
        "surface": 4279374354,
        "onSurface": 4293717228
      },
      "lightTextTheme": {
        "headlineSmall": { "fontFamily": "Lora", "fontSize": 24, "fontWeight": 700, "letterSpacing": 0, "height": 1.2, "color": 4279966491 },
        "titleMedium": { "fontFamily": "Lora", "fontSize": 18, "fontWeight": 600, "letterSpacing": 0, "height": 1.3, "color": 4279966491 },
        "bodyMedium": { "fontFamily": "SourceSans3", "fontSize": 16, "fontWeight": 400, "letterSpacing": 0.15, "height": 1.45, "color": 4279966491 },
        "labelLarge": { "fontFamily": "SourceSans3", "fontSize": 14, "fontWeight": 600, "letterSpacing": 0.1, "height": 1.2, "color": 4294967295 }
      },
      "darkTextTheme": {
        "headlineSmall": { "fontFamily": "Lora", "fontSize": 24, "fontWeight": 700, "letterSpacing": 0, "height": 1.2, "color": 4293717228 },
        "titleMedium": { "fontFamily": "Lora", "fontSize": 18, "fontWeight": 600, "letterSpacing": 0, "height": 1.3, "color": 4293717228 },
        "bodyMedium": { "fontFamily": "SourceSans3", "fontSize": 16, "fontWeight": 400, "letterSpacing": 0.15, "height": 1.45, "color": 4293717228 },
        "labelLarge": { "fontFamily": "SourceSans3", "fontSize": 14, "fontWeight": 600, "letterSpacing": 0.1, "height": 1.2, "color": 4278196864 }
      }
    }
  ]
}
