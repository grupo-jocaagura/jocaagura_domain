{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/death_record_model.schema.json",
  "title": "DeathRecordModel",
  "description": "Canonical JSON contract for DeathRecordModel in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the death record."
    },
    "notaria": {
      "$ref": "./store_model.schema.json",
      "description": "Notary office associated with the record."
    },
    "person": {
      "$ref": "./person_model.schema.json",
      "description": "Deceased person associated with the record."
    },
    "address": {
      "$ref": "./address_model.schema.json",
      "description": "Address where the death was recorded."
    },
    "recordId": {
      "type": "string",
      "description": "Official record identifier."
    }
  },
  "required": [
    "id",
    "notaria",
    "person",
    "address",
    "recordId"
  ],
  "examples": [
    {
      "id": "gx86GyNM",
