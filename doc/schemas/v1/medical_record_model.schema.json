{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/medical_record_model.schema.json",
  "title": "MedicalRecordModel",
  "description": "Canonical JSON contract for MedicalRecordModel in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the medical record."
