    },
    "address": {
      "$ref": "./address_model.schema.json"
    },
    "legalId": {
      "$ref": "./legal_id_model.schema.json"
    },
    "user": {
      "$ref": "./user_model.schema.json"
    },
    "appointments": {
      "type": "array",
      "items": {
        "$ref": "./appointment_model.schema.json"
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "$ref": "./medication_model.schema.json"
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "./contact_model.schema.json"
      }
    }
  },
  "required": [
    "id",
    "patient",
    "diagnoses",
    "dentalConditions",
    "treatmentPlan",
    "acceptanceClause",
    "address",
    "legalId",
    "user",
    "appointments",
    "medications",
    "contacts"
