    "patient": {
      "$ref": "./person_model.schema.json"
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "$ref": "./diagnosis_model.schema.json"
      }
    },
    "dentalConditions": {
      "type": "array",
      "items": {
        "$ref": "./dental_condition_model.schema.json"
      }
    },
    "treatmentPlan": {
