{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/model_assessment.schema.json",
  "title": "ModelAssessment",
  "description": "Canonical JSON contract for ModelAssessment in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "./model_learning_item.schema.json" }
    },
    "shuffleItems": { "type": "boolean" },
    "shuffleOptions": { "type": "boolean" },
    "timeLimitMs": { "type": "integer", "minimum": 0 },
    "passScore": { "type": "integer", "minimum": 0, "maximum": 100 }
  },
  "required": ["id", "title", "items", "shuffleItems", "shuffleOptions", "timeLimitMs", "passScore"]
}
