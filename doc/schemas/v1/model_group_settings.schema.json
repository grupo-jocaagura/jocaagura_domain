  "required": ["id", "groupId", "googleGroupId", "whoCanViewGroup", "whoCanViewMembership", "whoCanJoin", "whoCanPostMessage", "messageModerationLevel", "spamModerationLevel", "includeInGlobalAddressList", "membersCanPostAsTheGroup", "isArchived", "isCollaborativeInbox", "rawSettings", "fetchedAt"],
  "examples": [
    {
      "id": "settings-1",
      "groupId": "group-001",
      "googleGroupId": "AAA-BBB-CCC",
      "whoCanViewGroup": "ALL_MEMBERS_CAN_VIEW",
      "whoCanViewMembership": "ALL_MEMBERS_CAN_VIEW",
      "whoCanJoin": "INVITED_CAN_JOIN",
      "whoCanPostMessage": "ALL_MEMBERS_CAN_POST",
      "messageModerationLevel": "MODERATE_NONE",
      "spamModerationLevel": "MODERATE",
