{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/acceptance_clause_model.schema.json",
  "title": "AcceptanceClauseModel",
  "description": "Canonical JSON contract for AcceptanceClauseModel in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier of the acceptance clause."
    },
    "odontologistSignature": {
      "$ref": "./signature_model.schema.json",
      "description": "Signature of the odontologist."
    },
    "patientPrint": {
      "type": "string",
      "description": "Printed name of the patient."
    },
    "patientSignature": {
      "$ref": "./signature_model.schema.json",
      "description": "Signature of the patient."
    },
    "stringAcceptanceLeyend": {
      "type": "string",
      "description": "Acceptance text acknowledged by the patient."
    }
  },
  "required": [
    "id",
    "odontologistSignature",
    "patientPrint",
    "patientSignature",
    "stringAcceptanceLeyend"
  ],
  "examples": [
    {
      "id": "acm789",
      "odontologistSignature": {
        "id": "sig123",
        "created": "2024-07-28T00:00:00.000Z",
        "appId": "appOdonto123",
        "png64Image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB"
      },
      "patientPrint": "Juan Perez",
      "patientSignature": {
        "id": "sig456",
        "created": "2024-07-28T00:00:00.000Z",
        "appId": "appPatient456",
        "png64Image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB"
      },
      "stringAcceptanceLeyend": "Acepto los terminos y condiciones del tratamiento odontologico."
    }
  ]
}
