{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/appointment_model.schema.json",
  "title": "AppointmentModel",
  "description": "Canonical JSON contract for AppointmentModel in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the appointment."
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Appointment timestamp as ISO-8601 string."
    },
    "odontologist": {
      "type": "string",
      "description": "Name of the odontologist attending the appointment."
    },
    "purpose": {
      "type": "string",
      "description": "Purpose of the appointment."
    },
    "status": {
      "type": "string",
      "description": "Current status of the appointment."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes related to the appointment."
    }
  },
  "required": [
    "id",
    "date",
    "odontologist",
    "purpose",
    "status",
    "notes"
  ],
  "examples": [
    {
      "id": "appt001",
      "date": "2024-07-24T00:00:00.000Z",
      "odontologist": "Dr. Juan Pérez",
      "purpose": "Consulta General",
      "status": "Pendiente",
      "notes": "Revisar dolor en la muela"
    }
  ]
}
