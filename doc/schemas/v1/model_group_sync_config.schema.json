{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/model_group_sync_config.schema.json",
  "title": "ModelGroupSyncConfig",
  "description": "Canonical JSON contract for ModelGroupSyncConfig in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "groupId": { "type": "string" },
    "mode": { "type": "string", "enum": ["manual", "fromCourse", "fromSheet", "mixed"] },
    "courseId": { "type": "string" },
    "sourceSheetId": { "type": "string" },
    "sourceRange": { "type": "string" },
    "schedule": { "type": "string", "enum": ["onDemand", "hourly", "daily", "weekly"] },
    "strategy": { "type": "string", "enum": ["fullReplace", "merge", "onlyAdd", "onlyRemove"] },
    "lastResult": { "type": "string", "enum": ["never", "ok", "partialError", "error"] },
    "lastRunAt": { "type": "string", "format": "date-time" },
    "lastJobId": { "type": "string" },
    "lastErrorItemId": { "type": "string" },
    "crud": { "$ref": "./model_crud_metadata.schema.json" }
  },
  "required": ["id", "groupId", "mode", "courseId", "sourceSheetId", "sourceRange", "schedule", "strategy", "lastResult", "lastJobId", "lastErrorItemId", "crud"],
  "examples": [
    {
      "id": "sync-1",
      "groupId": "group-001",
      "mode": "fromSheet",
      "courseId": "",
      "sourceSheetId": "sheet-123",
      "sourceRange": "A2:D999",
      "schedule": "daily",
      "strategy": "fullReplace",
      "lastResult": "ok",
      "lastRunAt": "2025-01-01T10:00:00.000Z",
      "lastJobId": "job-987",
      "lastErrorItemId": "",
      "crud": {
        "recordId": "sync-1",
        "createdBy": "system@domain.com",
        "createdAt": "2025-01-01T10:00:00.000Z",
        "updatedBy": "system@domain.com",
        "updatedAt": "2025-01-01T10:00:00.000Z",
        "version": 1
      }
    }
  ]
}
