{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/error_item_model.schema.json",
  "title": "ErrorItem",
  "description": "Canonical JSON contract for ErrorItem in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "description": "Short title describing the error type."
    },
    "code": {
      "type": "string",
      "description": "Stable programmatic error code."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the error."
    },
    "meta": {
      "type": "object",
      "description": "Additional structured diagnostics context.",
      "additionalProperties": true
    },
    "errorLevel": {
      "type": "string",
      "description": "Severity and UI handling hint.",
      "enum": [
        "systemInfo",
        "warning",
        "severe",
        "danger"
      ]
    }
  },
  "required": [
    "title",
    "code",
    "description",
    "meta",
    "errorLevel"
  ],
  "examples": [
    {
      "title": "Network timeout",
      "code": "NET_TIMEOUT",
      "description": "The request took too long to complete.",
      "meta": {
        "retryAfterMs": 1500
      },
      "errorLevel": "severe"
    }
  ]
}
