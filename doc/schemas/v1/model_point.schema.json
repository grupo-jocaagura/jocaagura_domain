{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocaagura.dev/schemas/jocaagura_domain/v1/model_point.schema.json",
  "title": "ModelPoint",
  "description": "Canonical JSON contract for ModelPoint in jocaagura_domain.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": {
      "type": "string",
      "description": "Human-readable label of the point."
    },
    "vector": {
      "$ref": "./model_vector.schema.json",
      "description": "2D coordinates of the point."
    }
  },
  "required": [
    "label",
    "vector"
  ],
  "examples": [
    {
      "label": "January",
      "vector": {
        "dx": 1.0,
        "dy": 60000.0
      }
    }
  ]
}
